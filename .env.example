# LLM provider: gemini (initial) | claude (later)
LLM_PROVIDER=gemini

# Gemini (active provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Daily LLM call budget (fits the free-tier quota). Once spent, the scan skips
# remaining work gracefully instead of crashing. Lower it in prod if needed.
LLM_DAILY_BUDGET=18

# Claude (used once LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
NEPSE_MODEL=claude-sonnet-4-6

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Cron / internal auth
CRON_SECRET=

# Email alerts (optional)
RESEND_API_KEY=
