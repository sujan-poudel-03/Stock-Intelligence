# Provider selection. NEPSE_MODEL (below) is the single knob — when set it picks
# BOTH the model and the provider (claude-* -> claude, gemini-* -> gemini) and
# overrides LLM_PROVIDER. Leave NEPSE_MODEL blank to use LLM_PROVIDER + GEMINI_MODEL.
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Daily LLM call budget (per-DAY ceiling). Set this BELOW your model's free-tier
# RPD as a buffer: gemini-2.5-flash ~250/day -> use ~200; gemini-1.5-flash ~1500/day
# -> use ~1200. Per-MINUTE limits are handled by backoff in llm.js, not here. When
# the budget is spent the scan switches to deterministic budget-saver signals.
LLM_DAILY_BUDGET=200

# Single model knob (overrides LLM_PROVIDER when set):
#   claude-sonnet-4-6  -> Claude (Anthropic credits)
#   gemini-1.5-flash   -> Gemini, higher free quota for testing
ANTHROPIC_API_KEY=
NEPSE_MODEL=claude-sonnet-4-6

# Market data sources (admin-selectable, ordered, comma-separated). Feeds the
# verified-price layer (src/lib/marketData.js): quotes are cross-checked and must
# agree, and prices are ground truth — NEVER LLM-sourced. Correctness is the gate,
# freshness is not: a late-but-true quote (minutes/hours old) is accepted and just
# flagged "stale"; only wrong/disagreeing/implausible data is rejected. Unset =
# best-proposal default (two portals so cross-check has two sources to agree).
# Sources: merolagani (LIVE), sample (offline placeholder), sharesansar (not yet
# implemented), nepalstock (build-ready — needs NEPALSTOCK_API_TOKEN to enable).
MARKET_DATA_SOURCES=merolagani

# NEPSE Official (nepalstock) API token. The source stays DISABLED in the admin UI
# until this is set; once present it becomes selectable (admin-only).
NEPALSTOCK_API_TOKEN=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Cron / internal auth
CRON_SECRET=

# Admin gate (Google Sign-In). Comma-separated allowlist of admin Google emails.
# LEAVE BLANK for open/single-operator mode; SET it to enforce admin-only on
# /api/admin/* config changes. Requires Google auth wired (see docs/DEPLOYMENT.md).
ADMIN_EMAILS=
# Browser Supabase Auth (only needed once you enable Google Sign-In):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Notifications (all optional; a channel is ACTIVE only when its env is set).
# Email via Resend:
RESEND_API_KEY=
ALERT_TO=marketing@nepawholesale.com
# Telegram daily brief + failed/partial-scan alerts (needs BOTH):
#   1. create a bot via @BotFather -> TELEGRAM_BOT_TOKEN
#   2. get your chat id (message the bot, then GET /getUpdates) -> TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
