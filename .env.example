# LLM provider: gemini (initial) | claude (later)
LLM_PROVIDER=gemini

# Gemini (active provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Daily LLM call budget. This is the per-DAY ceiling (gemini-2.5-flash free tier
# is ~250 requests/day). Per-MINUTE rate limits are handled separately by backoff
# in llm.js, not here. Once the daily budget is spent the scan degrades gracefully.
LLM_DAILY_BUDGET=100

# Claude (used once LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
NEPSE_MODEL=claude-sonnet-4-6

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Cron / internal auth
CRON_SECRET=

# Email alerts (optional)
RESEND_API_KEY=
